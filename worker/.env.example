# Local Worker secrets. Copy to worker/.dev.vars (gitignored) for `wrangler dev`.
# Never commit real values. Guest play and Clerk token verification need none of these.

# Optional, reserved for future admin/QA tooling. Gameplay never uses it.
CLERK_SECRET_KEY=

# Public configuration lives in wrangler.jsonc (CLERK_ISSUER, WEB_URL).

# Deployment only (Cloudflare dashboard → API tokens). Not needed for local dev.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
